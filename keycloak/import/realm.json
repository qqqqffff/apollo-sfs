{
  "realm": "apollo-sfs-realm",
  "displayName": "Apollo SFS",
  "loginTheme": "apollo-sfs",
  "emailTheme": "apollo-sfs",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "editUsernameAllowed": true,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "accessTokenLifespan": 1800,
  "accessTokenLifespanForImplicitFlow": 1800,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 5184000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,
  "smtpServer": {
    "host": "postfix",
    "port": "587",
    "from": "noreply@apollo-sfs.com",
    "fromDisplayName": "Apollo SFS",
    "replyTo": "",
    "replyToDisplayName": "",
    "envelopeFrom": "",
    "starttls": "false",
    "ssl": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Application administrator \u2014 can manage users, send invitations, and view server metrics",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "premium",
        "description": "Premium subscriber - unlocks several premium features on the apollo sfs app after successful paypal capture",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "groups": [
    {
      "name": "premium",
      "path": "/premium",
      "realmRoles": ["premium"]
    }
  ],
  "clients": [
    {
      "clientId": "apollo-sfs-api",
      "name": "Apollo SFS API",
      "description": "Confidential client used by the Go API for ROPC token exchange and Admin REST API access",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "<secret>",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "https://apollo-sfs.com/*"
      ],
      "webOrigins": [
        "https://apollo-sfs.com"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "1800",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "audience mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "apollo-sfs-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "apollo-sfs-mobile",
      "name": "Apollo SFS Mobile",
      "description": "Public client for the native app. Browser-based Authorization Code + PKCE flow against Keycloak, including social login via identity-provider brokering (kc_idp_hint=google/apple). Replaces the deprecated external token-exchange path.",
      "enabled": true,
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "apollosfs://oauthredirect"
      ],
      "webOrigins": [
        "apollosfs://oauthredirect"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "1800",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "api audience mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "apollo-sfs-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "first broker login - auto link",
      "description": "First broker login with no Keycloak-rendered page. Review Profile is disabled (it would prompt), and an email that already belongs to a Keycloak user is auto-linked rather than dead-ending on 'Confirm link existing account'. Every identity provider's First login flow must point here — see KC_setup.md section 5.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-review-profile",
          "authenticatorConfig": "review profile config",
          "requirement": "DISABLED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "auto link - user creation or linking",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "auto link - user creation or linking",
      "description": "Create a Keycloak user for a brand-new brokered identity, or link an existing one.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorConfig": "create unique user config",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "auto link - handle existing account",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "auto link - handle existing account",
      "description": "Runs when the brokered email already belongs to a Keycloak user. idp-auto-link attaches the federated identity silently; the built-in confirm-link and verify-by-email/re-authentication steps are deliberately absent, since each one renders a Keycloak page.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-auto-link",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "review profile config",
      "config": {
        "update.profile.on.first.login": "off"
      }
    },
    {
      "alias": "create unique user config",
      "config": {
        "require.password.update.after.registration": "false"
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50
    }
  ]
}
